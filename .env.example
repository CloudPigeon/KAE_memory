# OpenAI-compatible API bases, filled in by the operator.
# Include the API prefix required by your provider.
PRISM_MAIN_BASE=
PRISM_MAIN_API_KEY=
PRISM_AUX_BASE=
PRISM_AUX_API_KEY=
PRISM_EMBEDDING_BASE=
PRISM_EMBEDDING_API_KEY=

# Optional writer service override when the offline compiler uses a separate model.
PRISM_WRITER_BASE=
PRISM_WRITER_API_KEY=

# Optional explicit proxy configuration.
PRISM_HTTP_PROXY=

# Optional workspace location. The default is the current working directory.
PRISM_WORKSPACE=
